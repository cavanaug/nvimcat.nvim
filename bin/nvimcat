#!/usr/bin/env python3
"""nvimcat — dump a file as ANSI using your full Neovim config.

Single binary: embed UI client (msgpack + grid + ANSI) and --shot2ansi for :NvimCat.
"""
from __future__ import annotations

import os
import re
import struct
import subprocess
import sys
import threading
import time
from pathlib import Path
from typing import Any, Callable

_ROOT = Path(__file__).resolve().parent.parent

# --- msgpack ----------------------------------------------------------------

class NeedMoreData(Exception):
    pass


def pack(obj: Any) -> bytes:
    if obj is None:
        return b"\xc0"
    if obj is False:
        return b"\xc2"
    if obj is True:
        return b"\xc3"
    if isinstance(obj, int):
        if 0 <= obj <= 127:
            return bytes([obj])
        if -32 <= obj < 0:
            return bytes([obj & 0xFF])
        if 0 <= obj <= 0xFF:
            return b"\xcc" + bytes([obj])
        if 0 <= obj <= 0xFFFF:
            return b"\xcd" + struct.pack(">H", obj)
        if 0 <= obj <= 0xFFFFFFFF:
            return b"\xce" + struct.pack(">I", obj)
        if -128 <= obj <= 127:
            return b"\xd0" + struct.pack("b", obj)
        if -32768 <= obj <= 32767:
            return b"\xd1" + struct.pack(">h", obj)
        if -2147483648 <= obj <= 2147483647:
            return b"\xd2" + struct.pack(">i", obj)
        return b"\xd3" + struct.pack(">q", obj)
    if isinstance(obj, float):
        return b"\xcb" + struct.pack(">d", obj)
    if isinstance(obj, (bytes, bytearray, memoryview)):
        b = bytes(obj)
        ln = len(b)
        if ln <= 0xFF:
            return b"\xc4" + bytes([ln]) + b
        if ln <= 0xFFFF:
            return b"\xc5" + struct.pack(">H", ln) + b
        return b"\xc6" + struct.pack(">I", ln) + b
    if isinstance(obj, str):
        b = obj.encode("utf-8")
        ln = len(b)
        if ln <= 31:
            return bytes([0xA0 + ln]) + b
        if ln <= 0xFF:
            return b"\xd9" + bytes([ln]) + b
        if ln <= 0xFFFF:
            return b"\xda" + struct.pack(">H", ln) + b
        return b"\xdb" + struct.pack(">I", ln) + b
    if isinstance(obj, (list, tuple)):
        n = len(obj)
        if n <= 15:
            out = bytes([0x90 + n])
        elif n <= 0xFFFF:
            out = b"\xdc" + struct.pack(">H", n)
        else:
            out = b"\xdd" + struct.pack(">I", n)
        return out + b"".join(pack(x) for x in obj)
    if isinstance(obj, dict):
        n = len(obj)
        if n <= 15:
            out = bytes([0x80 + n])
        elif n <= 0xFFFF:
            out = b"\xde" + struct.pack(">H", n)
        else:
            out = b"\xdf" + struct.pack(">I", n)
        for k, v in obj.items():
            out += pack(k) + pack(v)
        return out
    if isinstance(obj, Ext):
        return _pack_ext(obj.code, obj.data)
    raise TypeError(f"cannot pack {type(obj)!r}")


class Ext:
    """Opaque msgpack extension (Neovim Buffer/Window/etc.)."""

    __slots__ = ("code", "data")

    def __init__(self, code: int, data: bytes) -> None:
        self.code = code
        self.data = data


def _pack_ext(code: int, data: bytes) -> bytes:
    ln = len(data)
    if ln == 1:
        return b"\xd4" + struct.pack("b", code) + data
    if ln == 2:
        return b"\xd5" + struct.pack("b", code) + data
    if ln == 4:
        return b"\xd6" + struct.pack("b", code) + data
    if ln == 8:
        return b"\xd7" + struct.pack("b", code) + data
    if ln == 16:
        return b"\xd8" + struct.pack("b", code) + data
    if ln <= 0xFF:
        return b"\xc7" + bytes([ln]) + struct.pack("b", code) + data
    if ln <= 0xFFFF:
        return b"\xc8" + struct.pack(">H", ln) + struct.pack("b", code) + data
    return b"\xc9" + struct.pack(">I", ln) + struct.pack("b", code) + data


class Unpacker:
    def __init__(self) -> None:
        self._buf = bytearray()

    def feed(self, data: bytes) -> None:
        self._buf.extend(data)

    def unpack(self) -> Any:
        if not self._buf:
            raise NeedMoreData
        val, n = _unpack_one(memoryview(self._buf), 0)
        del self._buf[:n]
        return val


def _unpack_one(buf: memoryview, pos: int) -> tuple[Any, int]:
    if pos >= len(buf):
        raise NeedMoreData
    b0 = buf[pos]
    if b0 <= 0x7F:  # positive fixint
        return b0, pos + 1
    if 0xE0 <= b0 <= 0xFF:  # negative fixint
        return struct.unpack("b", bytes([b0]))[0], pos + 1
    if b0 == 0xC0:
        return None, pos + 1
    if b0 == 0xC2:
        return False, pos + 1
    if b0 == 0xC3:
        return True, pos + 1
    if 0xA0 <= b0 <= 0xBF:  # fixstr
        ln = b0 - 0xA0
        end = pos + 1 + ln
        if end > len(buf):
            raise NeedMoreData
        return bytes(buf[pos + 1 : end]).decode("utf-8"), end
    if 0x90 <= b0 <= 0x9F:  # fixarray
        n = b0 - 0x90
        return _unpack_array(buf, pos + 1, n)
    if 0x80 <= b0 <= 0x8F:  # fixmap
        n = b0 - 0x80
        return _unpack_map(buf, pos + 1, n)
    if b0 == 0xCC:
        if pos + 2 > len(buf):
            raise NeedMoreData
        return buf[pos + 1], pos + 2
    if b0 == 0xCD:
        if pos + 3 > len(buf):
            raise NeedMoreData
        return struct.unpack(">H", buf[pos + 1 : pos + 3])[0], pos + 3
    if b0 == 0xCE:
        if pos + 5 > len(buf):
            raise NeedMoreData
        return struct.unpack(">I", buf[pos + 1 : pos + 5])[0], pos + 5
    if b0 == 0xCF:
        if pos + 9 > len(buf):
            raise NeedMoreData
        return struct.unpack(">Q", buf[pos + 1 : pos + 9])[0], pos + 9
    if b0 == 0xD0:
        if pos + 2 > len(buf):
            raise NeedMoreData
        return struct.unpack("b", buf[pos + 1 : pos + 2])[0], pos + 2
    if b0 == 0xD1:
        if pos + 3 > len(buf):
            raise NeedMoreData
        return struct.unpack(">h", buf[pos + 1 : pos + 3])[0], pos + 3
    if b0 == 0xD2:
        if pos + 5 > len(buf):
            raise NeedMoreData
        return struct.unpack(">i", buf[pos + 1 : pos + 5])[0], pos + 5
    if b0 == 0xD3:
        if pos + 9 > len(buf):
            raise NeedMoreData
        return struct.unpack(">q", buf[pos + 1 : pos + 9])[0], pos + 9
    if b0 == 0xCA:
        if pos + 5 > len(buf):
            raise NeedMoreData
        return struct.unpack(">f", buf[pos + 1 : pos + 5])[0], pos + 5
    if b0 == 0xCB:
        if pos + 9 > len(buf):
            raise NeedMoreData
        return struct.unpack(">d", buf[pos + 1 : pos + 9])[0], pos + 9
    if b0 == 0xD9:
        if pos + 2 > len(buf):
            raise NeedMoreData
        ln = buf[pos + 1]
        end = pos + 2 + ln
        if end > len(buf):
            raise NeedMoreData
        return bytes(buf[pos + 2 : end]).decode("utf-8"), end
    if b0 == 0xDA:
        if pos + 3 > len(buf):
            raise NeedMoreData
        ln = struct.unpack(">H", buf[pos + 1 : pos + 3])[0]
        end = pos + 3 + ln
        if end > len(buf):
            raise NeedMoreData
        return bytes(buf[pos + 3 : end]).decode("utf-8"), end
    if b0 == 0xDB:
        if pos + 5 > len(buf):
            raise NeedMoreData
        ln = struct.unpack(">I", buf[pos + 1 : pos + 5])[0]
        end = pos + 5 + ln
        if end > len(buf):
            raise NeedMoreData
        return bytes(buf[pos + 5 : end]).decode("utf-8"), end
    if b0 == 0xC4:
        if pos + 2 > len(buf):
            raise NeedMoreData
        ln = buf[pos + 1]
        end = pos + 2 + ln
        if end > len(buf):
            raise NeedMoreData
        return bytes(buf[pos + 2 : end]), end
    if b0 == 0xC5:
        if pos + 3 > len(buf):
            raise NeedMoreData
        ln = struct.unpack(">H", buf[pos + 1 : pos + 3])[0]
        end = pos + 3 + ln
        if end > len(buf):
            raise NeedMoreData
        return bytes(buf[pos + 3 : end]), end
    if b0 == 0xC6:
        if pos + 5 > len(buf):
            raise NeedMoreData
        ln = struct.unpack(">I", buf[pos + 1 : pos + 5])[0]
        end = pos + 5 + ln
        if end > len(buf):
            raise NeedMoreData
        return bytes(buf[pos + 5 : end]), end
    if b0 == 0xDC:
        if pos + 3 > len(buf):
            raise NeedMoreData
        n = struct.unpack(">H", buf[pos + 1 : pos + 3])[0]
        return _unpack_array(buf, pos + 3, n)
    if b0 == 0xDD:
        if pos + 5 > len(buf):
            raise NeedMoreData
        n = struct.unpack(">I", buf[pos + 1 : pos + 5])[0]
        return _unpack_array(buf, pos + 5, n)
    if b0 == 0xDE:
        if pos + 3 > len(buf):
            raise NeedMoreData
        n = struct.unpack(">H", buf[pos + 1 : pos + 3])[0]
        return _unpack_map(buf, pos + 3, n)
    if b0 == 0xDF:
        if pos + 5 > len(buf):
            raise NeedMoreData
        n = struct.unpack(">I", buf[pos + 1 : pos + 5])[0]
        return _unpack_map(buf, pos + 5, n)
    if b0 in (0xD4, 0xD5, 0xD6, 0xD7, 0xD8):
        sizes = {0xD4: 1, 0xD5: 2, 0xD6: 4, 0xD7: 8, 0xD8: 16}
        ln = sizes[b0]
        end = pos + 2 + ln
        if end > len(buf):
            raise NeedMoreData
        code = struct.unpack("b", buf[pos + 1 : pos + 2])[0]
        return Ext(code, bytes(buf[pos + 2 : end])), end
    if b0 == 0xC7:
        if pos + 3 > len(buf):
            raise NeedMoreData
        ln = buf[pos + 1]
        end = pos + 3 + ln
        if end > len(buf):
            raise NeedMoreData
        code = struct.unpack("b", buf[pos + 2 : pos + 3])[0]
        return Ext(code, bytes(buf[pos + 3 : end])), end
    if b0 == 0xC8:
        if pos + 4 > len(buf):
            raise NeedMoreData
        ln = struct.unpack(">H", buf[pos + 1 : pos + 3])[0]
        end = pos + 4 + ln
        if end > len(buf):
            raise NeedMoreData
        code = struct.unpack("b", buf[pos + 3 : pos + 4])[0]
        return Ext(code, bytes(buf[pos + 4 : end])), end
    if b0 == 0xC9:
        if pos + 6 > len(buf):
            raise NeedMoreData
        ln = struct.unpack(">I", buf[pos + 1 : pos + 5])[0]
        end = pos + 6 + ln
        if end > len(buf):
            raise NeedMoreData
        code = struct.unpack("b", buf[pos + 5 : pos + 6])[0]
        return Ext(code, bytes(buf[pos + 6 : end])), end
    raise ValueError(f"unknown msgpack byte 0x{b0:02x} at {pos}")


def _unpack_array(buf: memoryview, pos: int, n: int) -> tuple[list[Any], int]:
    out: list[Any] = []
    for _ in range(n):
        val, pos = _unpack_one(buf, pos)
        out.append(val)
    return out, pos


def _unpack_map(buf: memoryview, pos: int, n: int) -> tuple[dict[Any, Any], int]:
    out: dict[Any, Any] = {}
    for _ in range(n):
        key, pos = _unpack_one(buf, pos)
        val, pos = _unpack_one(buf, pos)
        out[key] = val
    return out, pos

# --- grid -------------------------------------------------------------------

from typing import Any

Cell = tuple[str, int]


class Grid:
    """Accumulates UI grid_line / hl_attr_define state; emits ANSI on flush."""

    def __init__(self) -> None:
        self._hl: dict[int, dict[str, Any]] = {}
        self._width: dict[int, int] = {}
        self._height: dict[int, int] = {}
        self._rows: dict[int, list[list[tuple[str, int]]]] = {}
        # From UI default_colors_set: Normal fg/bg (missing hl attrs inherit these).
        self._default_fg: int | None = None
        self._default_bg: int | None = None

    def resize(self, height: int, width: int, grid: int = 1) -> None:
        """Resize grid (rows, cols). Same as grid_resize."""
        self.apply_grid_resize(grid, width, height)

    def apply_grid_resize(self, grid: int, width: int, height: int) -> None:
        self._width[grid] = width
        self._height[grid] = height
        rows = self._rows.setdefault(grid, [])
        while len(rows) < height:
            rows.append([(" ", 0)] * width)
        del rows[height:]
        for r in range(height):
            row = rows[r]
            if len(row) < width:
                row.extend([(" ", 0)] * (width - len(row)))
            elif len(row) > width:
                del row[width:]
            rows[r] = row

    def apply_default_colors_set(
        self,
        rgb_fg: int,
        rgb_bg: int,
        _rgb_sp: int = 0,
        _cterm_fg: int = 0,
        _cterm_bg: int = 0,
    ) -> None:
        self._default_fg = int(rgb_fg)
        self._default_bg = int(rgb_bg)

    def apply_hl_attr_define(
        self,
        hl_id: int,
        rgb_attrs: dict[str, Any],
        _cterm_attrs: dict[str, Any],
        _info: dict[str, Any],
    ) -> None:
        attrs: dict[str, Any] = {}
        if "foreground" in rgb_attrs:
            attrs["fg"] = int(rgb_attrs["foreground"])
        if "background" in rgb_attrs:
            attrs["bg"] = int(rgb_attrs["background"])
        for key in ("bold", "italic", "underline", "reverse"):
            if rgb_attrs.get(key):
                attrs[key] = True
        self._hl[hl_id] = attrs

    def apply_grid_line(
        self,
        grid: int,
        row: int,
        col_start: int,
        cells: list[list[Any]],
        _wrap: bool,
    ) -> None:
        if grid not in self._width:
            return
        width = self._width[grid]
        rows = self._rows.setdefault(grid, [])
        while len(rows) <= row:
            rows.append([(" ", 0)] * width)
        line = list(rows[row])
        if len(line) < width:
            line.extend([(" ", 0)] * (width - len(line)))
        col = col_start
        last_hl_id = 0
        for cell in cells:
            text = str(cell[0])
            if len(cell) > 1:
                last_hl_id = int(cell[1])
            hl_id = last_hl_id
            repeat = int(cell[2]) if len(cell) > 2 else 1
            for _ in range(repeat):
                if not text:
                    if col >= width:
                        break
                    line[col] = ("", hl_id)
                    col += 1
                    continue
                for ch in text:
                    if col >= width:
                        break
                    line[col] = (ch, hl_id)
                    col += 1
        rows[row] = line

    def apply_grid_clear(self, grid: int) -> None:
        if grid not in self._width:
            return
        w, h = self._width[grid], self._height.get(grid, 0)
        self._rows[grid] = [[(" ", 0)] * w for _ in range(h)]

    def apply_grid_destroy(self, grid: int) -> None:
        self._rows.pop(grid, None)
        self._width.pop(grid, None)
        self._height.pop(grid, None)

    def apply_grid_scroll(
        self,
        grid: int,
        top: int,
        bot: int,
        left: int,
        right: int,
        rows: int,
        cols: int,
    ) -> None:
        """Copy screen cells for ui-event-grid_scroll (end-exclusive region)."""
        if cols != 0 or grid not in self._width:
            return
        width = self._width[grid]
        grid_rows = self._rows.setdefault(grid, [])
        while len(grid_rows) < bot:
            grid_rows.append([(" ", 0)] * width)
        left = max(0, left)
        right = min(right, width)
        if right <= left or bot <= top or rows == 0:
            return

        def copy_row(src: int, dst: int) -> None:
            src_line = list(grid_rows[src])
            if len(src_line) < width:
                src_line.extend([(" ", 0)] * (width - len(src_line)))
            dst_line = list(grid_rows[dst])
            if len(dst_line) < width:
                dst_line.extend([(" ", 0)] * (width - len(dst_line)))
            dst_line[left:right] = src_line[left:right]
            grid_rows[dst] = dst_line

        def clear_row(row: int) -> None:
            line = list(grid_rows[row])
            if len(line) < width:
                line.extend([(" ", 0)] * (width - len(line)))
            line[left:right] = [(" ", 0)] * (right - left)
            grid_rows[row] = line

        if rows > 0:
            # Move SR content up (scroll down in the buffer).
            for row in range(top, bot - rows):
                copy_row(row + rows, row)
            for row in range(max(bot - rows, top), bot):
                clear_row(row)
        else:
            # Move SR content down (scroll up in the buffer).
            amount = -rows
            for row in range(bot - 1, top + amount - 1, -1):
                copy_row(row - amount, row)
            for row in range(top, min(top + amount, bot)):
                clear_row(row)

    def _resolve(self, hl_id: int) -> dict[str, Any]:
        """Neovim: missing rgb attrs inherit Normal (default_colors_set)."""
        attrs: dict[str, Any] = {}
        if self._default_fg is not None:
            attrs["fg"] = self._default_fg
        if self._default_bg is not None:
            attrs["bg"] = self._default_bg
        attrs.update(self._hl.get(hl_id, {}))
        if attrs.get("reverse"):
            attrs["fg"], attrs["bg"] = attrs.get("bg"), attrs.get("fg")
        return attrs

    def _sgr(self, hl_id: int, *, reset: bool = False) -> bytes:
        attrs = self._resolve(hl_id)
        parts: list[str] = []
        if reset:
            parts.append("0")
        if attrs.get("bold"):
            parts.append("1")
        if attrs.get("italic"):
            parts.append("3")
        if attrs.get("underline"):
            parts.append("4")
        # reverse already swapped in _resolve; do not emit 7
        if "fg" in attrs and attrs["fg"] is not None:
            c = int(attrs["fg"])
            parts.append(f"38;2;{(c >> 16) & 0xFF};{(c >> 8) & 0xFF};{c & 0xFF}")
        if "bg" in attrs and attrs["bg"] is not None:
            c = int(attrs["bg"])
            parts.append(f"48;2;{(c >> 16) & 0xFF};{(c >> 8) & 0xFF};{c & 0xFF}")
        if not parts or (reset and len(parts) == 1):
            return b"\x1b[0m"
        return f"\x1b[{';'.join(parts)}m".encode()

    @staticmethod
    def _is_eob_row(row: list[tuple[str, int]]) -> bool:
        text = "".join(ch for ch, _ in row).rstrip()
        return text == "~" or (len(text) > 0 and set(text) <= {"~"})

    @staticmethod
    def _is_statusline_row(row: list[tuple[str, int]]) -> bool:
        # lualine / airline leak when laststatus flips back on between stitch pages.
        text = "".join(ch for ch, _ in row).strip()
        if not text:
            return False
        return bool(
            re.match(
                r"^(NORMAL|INSERT|VISUAL|V-BLOCK|V-LINE|REPLACE|COMMAND|TERMINAL)\b",
                text,
            )
        )

    def _row_to_ansi(self, row: list[tuple[str, int]]) -> bytes:
        # Keep default-bg padding so blank lines / table tails match the TUI.
        # Only drop trailing spaces when we have no Normal bg to paint.
        trimmed = list(row)
        if self._default_bg is None:
            while trimmed and trimmed[-1][0] == " " and trimmed[-1][1] == 0:
                trimmed.pop()
        # Drop winbar/status overlays that sometimes paint into the last
        # viewport row at page boundaries (seen as trailing "✔ Index").
        plain = "".join(ch for ch, _ in trimmed)
        for junk in ("✔ Index", "✓ Index"):
            idx = plain.rfind(junk)
            if idx != -1 and plain[idx:].strip() == junk:
                trimmed = trimmed[:idx]
                while trimmed and trimmed[-1][0] == " ":
                    trimmed.pop()
                break
        out = bytearray()
        cur_hl: int | None = None
        buf = bytearray()
        for ch, hl_id in trimmed:
            if not ch:
                continue
            if hl_id != cur_hl:
                if buf:
                    out.extend(buf)
                    buf.clear()
                out.extend(self._sgr(hl_id, reset=cur_hl is not None))
                cur_hl = hl_id
            buf.extend(ch.encode("utf-8"))
        if buf:
            out.extend(buf)
        if out:
            out.extend(b"\x1b[0m")
        return bytes(out)

    def to_ansi(self, grid: int = 1, max_rows: int | None = None) -> bytes:
        rows = self._rows.get(grid, [])
        # Drop end-of-buffer `~` rows and anything below (status/cmdline chrome).
        end = len(rows)
        for i, row in enumerate(rows):
            if self._is_eob_row(row):
                end = i
                break
        if max_rows is not None and max_rows > 0:
            end = min(end, max_rows)
        lines = [
            self._row_to_ansi(row)
            for row in rows[:end]
            if not self._is_statusline_row(row)
        ]
        while lines and lines[-1] in (b"", b"\x1b[0m"):
            lines.pop()
        # Trailing blank buffer lines (no text) — keep; user content may need them.
        return b"\n".join(lines) + (b"\n" if lines else b"")

# --- shot2ansi --------------------------------------------------------------

# Drop terminal mode / cursor / charset noise; keep SGR (m) and text.
CSI_DROP = re.compile(
    rb"\x1b\[\?(?:25[lh]|[0-9;]*[hl])"  # DEC private modes (cursor, etc.)
    rb"|\x1b\[[0-9;]*[HfJABCD]"  # cursor / erase
    rb"|\x1b\(B"  # G0 charset → ASCII
)
SGR = re.compile(rb"\x1b\[[0-9;]*m")


def plain(line: bytes) -> bytes:
    return SGR.sub(b"", line)


def sgr_resets(seq: bytes) -> bool:
    """True if this SGR clears prior attrs (0 / empty)."""
    if seq in (b"\x1b[m", b"\x1b[0m"):
        return True
    # \x1b[0;...m starts from defaults
    return seq.startswith(b"\x1b[0;") or seq.startswith(b"\x1b[0m")


def split_preserving_sgr(body: bytes) -> list[bytes]:
    """Split CR LF rows, carrying SGR state into the next line.

    nvim__screenshot omits SGR when the next cell matches the previous
    cell's attrs — including across wrapped rows — so naive splits drop
    leading style on the following line.
    """
    sgr_state = b""
    line = bytearray()
    out: list[bytes] = []
    i = 0
    n = len(body)
    while i < n:
        if body[i : i + 2] == b"\r\n":
            out.append(bytes(line))
            # Next row inherits current attrs until an explicit SGR.
            line = bytearray(sgr_state)
            i += 2
            continue
        if body[i] == 0x0A:  # lone LF
            out.append(bytes(line))
            line = bytearray(sgr_state)
            i += 1
            continue
        m = SGR.match(body, i)
        if m:
            seq = m.group(0)
            line.extend(seq)
            if sgr_resets(seq):
                sgr_state = b"" if seq in (b"\x1b[m", b"\x1b[0m") else seq
            else:
                sgr_state += seq
            i = m.end()
            continue
        line.append(body[i])
        i += 1
    if line:
        out.append(bytes(line))
    return out


def shot2ansi_main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    data = open(args[0], "rb").read() if args else sys.stdin.buffer.read()
    if not data:
        return 1
    nl = data.find(b"\n")
    if nl < 0:
        return 1
    header, body = data[:nl].decode("ascii", "replace"), data[nl + 1 :]
    try:
        height, width = (int(x) for x in header.split(",", 1))
    except ValueError:
        height, width = 0, 0
    del height, width

    # Screenshot starts with clear-screen; content follows.
    idx = body.find(b"\x1b[2J")
    if idx >= 0:
        body = body[idx + 4 :]

    body = CSI_DROP.sub(b"", body)
    raw_lines = split_preserving_sgr(body)
    out: list[bytes] = []
    for raw in raw_lines:
        if not raw:
            continue
        raw = raw.rstrip(b"\r")
        p = plain(raw)
        # End-of-buffer filler
        if re.fullmatch(rb"~[\s~]*", p):
            break
        # Drop cmdline / error / status crumbs that sometimes land on last rows
        if p.startswith(b"E1568:") or p.startswith(b"E[0-9]"):
            break
        if b"Terminal did not respond" in p:
            break
        # Statusline leak (laststatus not fully cleared)
        if p.startswith(b"NORMAL") or p.lstrip().startswith(b"NORMAL "):
            break
        out.append(raw)

    # Trim trailing blank (whitespace-only) rows
    while out and not plain(out[-1]).strip():
        out.pop()

    sys.stdout.buffer.write(b"\n".join(out) + (b"\n" if out else b""))
    return 0

# --- embed ------------------------------------------------------------------

class NvimEmbed:
    def __init__(
        self,
        argv: list[str] | None = None,
        env: dict[str, str] | None = None,
        on_notify: Callable[[str, list[Any]], None] | None = None,
    ) -> None:
        self._on_notify = on_notify or (lambda _m, _a: None)
        self._unpacker = Unpacker()
        self._next_id = 1
        self._pending: dict[int, dict[str, Any]] = {}
        self._lock = threading.Lock()
        self._send_lock = threading.Lock()
        self._proc = subprocess.Popen(
            argv or ["nvim", "--embed", "--clean", "-n", "--headless"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=env,
            bufsize=0,
        )
        assert self._proc.stdin and self._proc.stdout
        self._stdin = self._proc.stdin
        self._stdout_fd = self._proc.stdout.fileno()
        self._reader = threading.Thread(target=self._read_loop, daemon=True)
        self._reader.start()

    def _read_loop(self) -> None:
        assert self._proc.stdout
        while True:
            chunk = self._proc.stdout.read(1 << 16)
            if not chunk:
                break
            self._unpacker.feed(chunk)
            while True:
                try:
                    msg = self._unpacker.unpack()
                except NeedMoreData:
                    break
                self._dispatch(msg)

    def _dispatch(self, msg: Any) -> None:
        if not isinstance(msg, list) or not msg:
            return
        kind = msg[0]
        if kind == 1 and len(msg) >= 4:  # response
            req_id = msg[1]
            with self._lock:
                slot = self._pending.pop(req_id, None)
            if slot is not None:
                slot["error"] = msg[2]
                slot["result"] = msg[3]
                slot["event"].set()
        elif kind == 2 and len(msg) >= 3:  # notification
            self._on_notify(msg[1], msg[2] if isinstance(msg[2], list) else [])
        elif kind == 0 and len(msg) >= 4:  # request from nvim (e.g. "vimenter")
            req_id = msg[1]
            self._send([1, req_id, None, None])

    def _send(self, obj: Any) -> None:
        with self._send_lock:
            self._stdin.write(pack(obj))
            self._stdin.flush()

    def request(self, method: str, *args: Any, timeout: float | None = None) -> Any:
        req_id = self._next_id
        self._next_id += 1
        ev = threading.Event()
        slot = {"event": ev, "error": None, "result": None}
        with self._lock:
            self._pending[req_id] = slot
        self._send([0, req_id, method, list(args)])
        deadline = time.time() + (timeout if timeout is not None else 30)
        while not ev.is_set():
            if time.time() >= deadline:
                raise TimeoutError(f"RPC timeout: {method}")
            if self._proc.poll() is not None:
                with self._lock:
                    self._pending.pop(req_id, None)
                if slot["error"] is not None:
                    raise RuntimeError(slot["error"])
                return slot["result"]
            ev.wait(timeout=0.05)
        if slot["error"] is not None:
            raise RuntimeError(slot["error"])
        return slot["result"]

    def ui_attach(self, width: int, height: int, **options: Any) -> None:
        opts = {"rgb": True, "ext_linegrid": True, **options}
        self.request("nvim_ui_attach", width, height, opts)

    def close(self) -> None:
        try:
            self._stdin.close()
        except OSError:
            pass
        try:
            self._proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self._proc.terminate()
            self._proc.wait(timeout=5)


# Neovim clamps UI height (&lines) at 1000. Above that, try_resize is futile and
# truncates output unless we scroll-stitch pages.
_UI_MAX_LINES = 1000
# Canonical viewport for tall-file stitch. MUST stay fixed across runs — changing
# paint height changes render-markdown layout and breaks output identity.
# Perf experiments: NVIMCAT_STITCH_HEIGHT (not NVIMCAT_PAGE_LINES).
_STITCH_UI_HEIGHT = 100


def _stitch_ui_height() -> int:
    raw = os.environ.get("NVIMCAT_STITCH_HEIGHT", "").strip()
    if raw.isdigit() and int(raw) > 0:
        return max(24, min(_UI_MAX_LINES, int(raw)))
    return _STITCH_UI_HEIGHT


def _estimate_rows(paths: list[str]) -> int:
    total = 0
    for path in paths:
        try:
            with open(path, "rb") as fh:
                total += sum(1 for _ in fh)
        except OSError:
            total += 40
    if not paths:
        total = 40
    want = total + 32
    if want <= _UI_MAX_LINES:
        return max(24, want)
    # Tall files: canonical stitch height (content-aware capture resizes per block).
    return _stitch_ui_height()


def _is_table_line(line: str) -> bool:
    s = line.lstrip()
    return s.startswith("|") or (s.startswith(":") and "|" in s)


def _content_block_end(lines: list[str], start: int) -> int:
    """Inclusive 1-based end of the markdown block containing `start`."""
    n = len(lines)
    if start < 1 or start > n:
        return max(1, min(start, n))
    i = start - 1
    line = lines[i]

    if _is_table_line(line):
        j = i
        while j < n and _is_table_line(lines[j]):
            j += 1
        return j  # j is exclusive 0-based → inclusive 1-based end

    stripped = line.strip()
    if stripped.startswith("```"):
        j = i + 1
        while j < n and not lines[j].strip().startswith("```"):
            j += 1
        return min(j + 1, n) if j < n else n

    if stripped.startswith("#"):
        return start

    # Paragraph / list: through next blank or structural boundary.
    j = i + 1
    while j < n:
        s = lines[j].strip()
        if not s:
            break
        if s.startswith("#") or s.startswith("```") or _is_table_line(lines[j]):
            break
        j += 1
    return j  # exclusive 0-based j → inclusive 1-based last content line is j


def _nvim_argv(root: str, nvim_bin: str | None = None) -> list[str]:
    root_esc = root.replace("\\", "\\\\").replace("'", "\\'")
    return [
        nvim_bin or os.environ.get("NVIMCAT_NVIM_BIN", "nvim"),
        "--embed",
        "-n",
        "--cmd",
        "let g:nvimcat = 1",
        "--cmd",
        f"let g:nvimcat_root = '{root_esc}'",
        "--cmd",
        "let g:copilot_enabled = v:false",
        "--cmd",
        f"set rtp^={root}",
    ]


def _apply_redraw(grid: Grid, events: list[Any]) -> bool:
    flushed = False
    for ev in events:
        if not ev:
            continue
        name = ev[0]
        if name == "flush":
            flushed = True
            continue
        for item in ev[1:]:
            if name == "grid_resize" and isinstance(item, list) and len(item) >= 3:
                grid.apply_grid_resize(int(item[0]), int(item[1]), int(item[2]))
            elif name == "grid_line" and isinstance(item, list) and len(item) >= 5:
                grid.apply_grid_line(
                    int(item[0]), int(item[1]), int(item[2]), item[3], bool(item[4])
                )
            elif name == "grid_clear" and isinstance(item, list) and item:
                grid.apply_grid_clear(int(item[0]))
            elif name == "grid_destroy" and isinstance(item, list) and item:
                grid.apply_grid_destroy(int(item[0]))
            elif name == "grid_scroll" and isinstance(item, list) and len(item) >= 7:
                grid.apply_grid_scroll(
                    int(item[0]),
                    int(item[1]),
                    int(item[2]),
                    int(item[3]),
                    int(item[4]),
                    int(item[5]),
                    int(item[6]),
                )
            elif name == "hl_attr_define" and isinstance(item, list) and len(item) >= 4:
                grid.apply_hl_attr_define(int(item[0]), item[1], item[2], item[3])
            elif name == "default_colors_set" and isinstance(item, list) and len(item) >= 2:
                grid.apply_default_colors_set(*item[:5])
    return flushed


def _trim_page_overlap(prev: bytes, nxt: bytes) -> bytes:
    """Drop leading lines of nxt that duplicate the tail of prev (stale-grid stitch)."""
    if not prev or not nxt:
        return nxt
    prev_lines = prev.split(b"\n")
    nxt_lines = nxt.split(b"\n")
    if prev_lines and prev_lines[-1] == b"":
        prev_lines = prev_lines[:-1]
    trailing_nl = nxt.endswith(b"\n")
    if nxt_lines and nxt_lines[-1] == b"":
        nxt_lines = nxt_lines[:-1]

    def key(line: bytes) -> bytes:
        # Compare without SGR / trailing spaces — page chrome can tweak attrs.
        return SGR.sub(b"", line).rstrip()

    max_check = min(len(prev_lines), len(nxt_lines), 80)
    for overlap in range(max_check, 0, -1):
        if [key(x) for x in prev_lines[-overlap:]] == [key(x) for x in nxt_lines[:overlap]]:
            nxt_lines = nxt_lines[overlap:]
            break
    if not nxt_lines:
        return b""
    body = b"\n".join(nxt_lines)
    return body + (b"\n" if trailing_nl else b"")


def _wait_grid_change(
    nv: "NvimEmbed",
    grid: Grid,
    grid_lock: threading.Lock,
    flush_ev: threading.Event,
    before: bytes,
    *,
    deadline: float,
    want_top: int | None = None,
    max_wait: float = 0.5,
) -> bytes:
    """Wait until grid ANSI changes from `before` and stays stable across flushes."""
    page_deadline = min(deadline, time.time() + max_wait)
    latest = before
    stable = 0
    while time.time() < page_deadline:
        flush_ev.wait(timeout=min(0.05, max(0.0, page_deadline - time.time())))
        flush_ev.clear()
        if want_top is not None:
            try:
                cur = _win_page_info(nv, max(0.0, deadline - time.time()))
            except (TimeoutError, RuntimeError):
                continue
            if cur["top"] < want_top:
                continue
        with grid_lock:
            now = grid.to_ansi()
        if now != before and now == latest:
            stable += 1
            if stable >= 2:
                return now
        else:
            stable = 0
        latest = now
    with grid_lock:
        return grid.to_ansi()


def _win_page_info(nv: "NvimEmbed", timeout: float) -> dict[str, int]:
    """Buffer topline / bottom / last via window view (1-based line numbers)."""
    info = nv.request(
        "nvim_exec_lua",
        """
local view = vim.fn.winsaveview()
local win = vim.api.nvim_get_current_win()
return {
  top = view.topline or 1,
  bot = vim.fn.line('w$'),
  last = vim.fn.line('$'),
  height = vim.api.nvim_win_get_height(win),
}
""",
        [],
        timeout=timeout,
    )
    if not isinstance(info, dict):
        return {"top": 1, "bot": 1, "last": 1, "height": 0}
    return {
        "top": int(info.get("top") or 1),
        "bot": int(info.get("bot") or 1),
        "last": int(info.get("last") or 1),
        "height": int(info.get("height") or 0),
    }


def _compose_load_plugins(nv: "NvimEmbed", timeout: float) -> None:
    nv.request(
        "nvim_exec_lua",
        """
local ok = pcall(require, "lazy")
if ok then
  local loader_ok, loader = pcall(require, "lazy.core.loader")
  if loader_ok then
    pcall(loader.load, {
      plugins = {
        "render-markdown.nvim",
        "render-markdown-mermaid.nvim",
      },
    }, { start = "nvimcat-compose" })
  end
  pcall(vim.cmd, "doautocmd FileType " .. (vim.bo.filetype ~= "" and vim.bo.filetype or "markdown"))
end
local width = tonumber(vim.env.NVIMCAT_WIDTH)
if width then
  vim.o.columns = width
end
pcall(function()
  vim.wo[vim.api.nvim_get_current_win()].conceallevel = 2
  vim.wo[vim.api.nvim_get_current_win()].concealcursor = ""
end)
local ok_ui, ui = pcall(require, "render-markdown.core.ui")
if ok_ui then
  pcall(function() require("render-markdown").set(true) end)
  pcall(ui.update, vim.api.nvim_get_current_buf(), vim.api.nvim_get_current_win(),
    "nvimcat-compose", true)
  vim.cmd("redraw!")
end
return ok_ui
""",
        [],
        timeout=timeout,
    )


def _scroll_page(nv: "NvimEmbed", next_top: int, timeout: float) -> None:
    """Scroll so topline=next_top and force a render-markdown update for the new viewport."""
    nv.request(
        "nvim_exec_lua",
        f"""
local top = {int(next_top)}
local win = vim.api.nvim_get_current_win()
local buf = vim.api.nvim_get_current_buf()
vim.fn.winrestview({{ lnum = top, col = 0, topline = top, leftcol = 0 }})
-- LazyVim/lualine can flip laststatus back on between pages; kill chrome each scroll.
vim.o.laststatus = 0
vim.o.showtabline = 0
vim.o.cmdheight = 0
pcall(function()
  vim.o.winbar = ""
  vim.wo[win].winbar = ""
end)
local ok, ui = pcall(require, "render-markdown.core.ui")
if not ok then
  vim.cmd("redraw!")
  return
end
local decorator = ui.get(buf)
local before = decorator.n
pcall(function()
  ui.update(buf, win, "nvimcat-page", true)
end)
-- Wait for this page's parse, not stale extmarks from the previous page.
vim.wait(200, function()
  return decorator.n > before
end, 10)
vim.cmd("redraw!")
""",
        [],
        timeout=timeout,
    )


_COMPOSE_BUFFER_LINES = 250
_COMPOSE_MAX_ROWS = 1000


def _compose_sgr(attrs: dict[str, Any], *, reset: bool) -> bytes:
    attrs = dict(attrs)
    fg = attrs.get("foreground")
    bg = attrs.get("background")
    if attrs.get("reverse"):
        fg, bg = bg, fg

    parts: list[str] = ["0"] if reset else []
    for key, code in (
        ("bold", "1"),
        ("dim", "2"),
        ("italic", "3"),
        ("underline", "4"),
        ("undercurl", "4"),
        ("strikethrough", "9"),
        ("standout", "7"),
    ):
        if attrs.get(key):
            parts.append(code)
    if fg is not None:
        color = int(fg)
        parts.append(f"38;2;{(color >> 16) & 0xFF};{(color >> 8) & 0xFF};{color & 0xFF}")
    if bg is not None:
        color = int(bg)
        parts.append(f"48;2;{(color >> 16) & 0xFF};{(color >> 8) & 0xFF};{color & 0xFF}")
    return f"\x1b[{';'.join(parts)}m".encode() if parts else b""


def _compose_row_to_ansi(row: dict[str, Any]) -> bytes:
    cells = list(row.get("cells") or [])
    while cells and cells[-1].get("text") == " " and not cells[-1].get("highlight"):
        cells.pop()

    out = bytearray()
    current: dict[str, Any] | None = None
    emitted = False
    for cell in cells:
        attrs = dict(cell.get("highlight") or {})
        if attrs != current:
            if current is not None:
                out.extend(_compose_sgr(attrs, reset=True))
            else:
                out.extend(_compose_sgr(attrs, reset=False))
            current = attrs
            emitted = emitted or bool(attrs)
        text = cell.get("text") or ""
        out.extend(str(text).encode("utf-8"))
    if emitted:
        out.extend(b"\x1b[0m")
    return bytes(out)


def _compose_rows_to_ansi(rows: list[Any]) -> bytes:
    lines = [_compose_row_to_ansi(row) for row in rows if isinstance(row, dict)]
    return b"\n".join(lines) + (b"\n" if lines else b"")


def _capture_composed(width: int, files: list[str]) -> int | None:
    """Stream bounded compose-API ranges, or return None if the API is unavailable."""
    root = os.environ.get("NVIMCAT_ROOT") or str(_ROOT)
    timeout = float(os.environ.get("NVIMCAT_TIMEOUT", "60"))
    env = os.environ.copy()
    env["NVIMCAT"] = "1"
    env["NVIMCAT_ROOT"] = root
    env["NVIMCAT_WIDTH"] = str(width)
    env["NVIMCAT_COMPOSE"] = "1"
    env["NVIMCAT_EMBED"] = "1"
    env["NVIMCAT_FILES"] = "\x1e".join(files) + ("\x1e" if files else "")

    nvim_bin = env.get("NVIMCAT_NVIM_BIN", "nvim")
    nv = NvimEmbed(argv=_nvim_argv(root, nvim_bin), env=env)
    deadline = time.time() + timeout
    wrote_any = False
    rc = 1
    try:
        try:
            nv.ui_attach(width, _COMPOSE_BUFFER_LINES)
            nv.request("nvim_ui_detach")
            nv.request("nvim_command", f"luafile {root}/scripts/cli-entry.lua")
        except (TimeoutError, RuntimeError) as exc:
            print(f"nvimcat: compose unavailable, falling back: {exc}", file=sys.stderr)
            return None
        while time.time() < deadline:
            if nv._proc.poll() is not None:
                return None if not wrote_any else 1

            try:
                done = nv.request("nvim_get_var", "nvimcat_done", timeout=0.5)
            except (TimeoutError, RuntimeError):
                done = 0
            if done == 1:
                rc = 0
                break

            try:
                capture = nv.request("nvim_get_var", "nvimcat_capture", timeout=0.5)
            except (TimeoutError, RuntimeError):
                continue
            if capture != 1:
                continue

            try:
                _compose_load_plugins(nv, max(1.0, deadline - time.time()))
                line_count = int(nv.request("nvim_buf_line_count", 0, timeout=1))
                file_started = False
                for start in range(0, max(line_count, 1), _COMPOSE_BUFFER_LINES):
                    end = min(line_count, start + _COMPOSE_BUFFER_LINES)
                    _scroll_page(nv, start + 1, max(1.0, deadline - time.time()))
                    rows = nv.request(
                        "nvim_win_get_screen_lines",
                        0,
                        {
                            "start_row": start,
                            "end_row": end,
                            "width": width,
                            "max_rows": _COMPOSE_MAX_ROWS,
                        },
                        timeout=max(1.0, deadline - time.time()),
                    )
                    if not isinstance(rows, list):
                        raise RuntimeError("compose API returned a non-array result")
                    chunk = _compose_rows_to_ansi(rows)
                    if not chunk:
                        continue
                    if wrote_any and not file_started:
                        sys.stdout.buffer.write(b"\n")
                    sys.stdout.buffer.write(chunk)
                    sys.stdout.buffer.flush()
                    wrote_any = True
                    file_started = True
                nv.request("nvim_set_var", "nvimcat_capture", 0, timeout=1)
            except BrokenPipeError:
                try:
                    nv.request("nvim_set_var", "nvimcat_capture", 0, timeout=1)
                except (TimeoutError, RuntimeError):
                    pass
                return 0
            except (TimeoutError, RuntimeError) as exc:
                if wrote_any:
                    print(f"nvimcat: compose failed after output: {exc}", file=sys.stderr)
                    return 1
                print(f"nvimcat: compose unavailable, falling back: {exc}", file=sys.stderr)
                return None
        else:
            print("nvimcat: timed out waiting for compose capture", file=sys.stderr)
    finally:
        nv.close()
    return rc


def capture(width: int, files: list[str]) -> int:
    if os.environ.get("NVIMCAT_COMPOSE") == "1":
        composed = _capture_composed(width, files)
        if composed is not None:
            return composed

    root = os.environ.get("NVIMCAT_ROOT") or str(_ROOT)
    height = _estimate_rows(files)
    timeout = float(os.environ.get("NVIMCAT_TIMEOUT", "60"))

    env = os.environ.copy()
    env["NVIMCAT"] = "1"
    env["NVIMCAT_ROOT"] = root
    env["NVIMCAT_WIDTH"] = str(width)
    env["NVIMCAT_EMBED"] = "1"
    env["NVIMCAT_FILES"] = "\x1e".join(files) + ("\x1e" if files else "")

    grid = Grid()
    grid_lock = threading.Lock()
    flush_ev = threading.Event()
    awaiting_resize_flush = False
    output_parts: list[bytes] = []
    pages_done = 0
    buf_lines: int | None = None

    def on_notify(method: str, args: list[Any]) -> None:
        if method != "redraw":
            return
        with grid_lock:
            flushed = _apply_redraw(grid, args)
        if flushed:
            flush_ev.set()

    nv = NvimEmbed(argv=_nvim_argv(root), env=env, on_notify=on_notify)
    deadline = time.time() + timeout
    rc = 1
    try:
        nv.ui_attach(width, height)
        nv.request("nvim_command", f"luafile {root}/scripts/cli-entry.lua")

        while time.time() < deadline:
            if nv._proc.poll() is not None:
                print("nvimcat: nvim exited early", file=sys.stderr)
                break

            remaining = max(0.0, deadline - time.time())
            wait = min(0.1, remaining)
            if not flush_ev.wait(timeout=wait):
                continue
            flush_ev.clear()

            try:
                done = nv.request("nvim_get_var", "nvimcat_done", timeout=remaining)
            except (TimeoutError, RuntimeError):
                done = 0
            if done == 1:
                sys.stdout.buffer.write(b"".join(output_parts))
                sys.stdout.buffer.flush()
                try:
                    nv.request("nvim_command", "qa!", timeout=5)
                except (TimeoutError, RuntimeError):
                    pass
                rc = 0
                break

            try:
                cap = nv.request("nvim_get_var", "nvimcat_capture", timeout=remaining)
            except (TimeoutError, RuntimeError):
                continue
            if cap != 1:
                continue

            if not awaiting_resize_flush:
                try:
                    rows = nv.request("nvim_get_var", "nvimcat_rows", timeout=remaining)
                except (TimeoutError, RuntimeError):
                    rows = None
                try:
                    buf_lines = nv.request(
                        "nvim_get_var", "nvimcat_buf_lines", timeout=remaining
                    )
                except (TimeoutError, RuntimeError):
                    buf_lines = None
                # Whole buffer fits in one UI page → resize once. Tall buffers keep
                # the page height and scroll-stitch (Neovim clamps &lines at 1000).
                fits = (
                    isinstance(rows, int)
                    and rows > 0
                    and rows != height
                    and rows <= _UI_MAX_LINES
                    and not (isinstance(buf_lines, int) and buf_lines > height)
                )
                if fits:
                    nv.request("nvim_ui_try_resize", width, rows, timeout=remaining)
                    height = rows
                    nv.request("nvim_command", "redraw!", timeout=remaining)
                    awaiting_resize_flush = True
                    continue

            # Tall buffers: plugins (LazyVim last_loc) may have scrolled to EOF
            # after Lua pinned topline=1. Force page 1 before stitching.
            if (
                pages_done == 0
                and isinstance(buf_lines, int)
                and buf_lines > height
            ):
                flush_ev.clear()
                try:
                    with grid_lock:
                        before_top = grid.to_ansi()
                    _scroll_page(nv, 1, max(0.0, deadline - time.time()))
                    _wait_grid_change(
                        nv,
                        grid,
                        grid_lock,
                        flush_ev,
                        before_top,
                        deadline=deadline,
                    )
                except (TimeoutError, RuntimeError) as exc:
                    print(f"nvimcat: scroll-to-top failed: {exc}", file=sys.stderr)
                flush_ev.clear()

            # Content-aware stitch: grow the viewport to fit each markdown block
            # (table/fence) when possible so we do not cut mid-table. Paint height
            # never follows NVIMCAT_PAGE_LINES — only NVIMCAT_STITCH_HEIGHT / default.
            buf_text: list[str] = []
            try:
                raw_lines = nv.request(
                    "nvim_buf_get_lines",
                    0,
                    0,
                    -1,
                    True,
                    timeout=max(1.0, deadline - time.time()),
                )
                if isinstance(raw_lines, list):
                    buf_text = [str(x) for x in raw_lines]
            except (TimeoutError, RuntimeError):
                buf_text = []

            stitch_h = _stitch_ui_height()
            topline = 1
            last_line = len(buf_text) if buf_text else int(buf_lines or 1)

            while time.time() < deadline and topline <= last_line and pages_done < 500:
                if buf_text:
                    block_end = _content_block_end(buf_text, topline)
                    block_len = max(1, block_end - topline + 1)
                else:
                    block_end = last_line
                    block_len = last_line - topline + 1

                if stitch_h < block_len <= _UI_MAX_LINES:
                    # Grow to fit a whole mid-size block (avoid mid-table cuts).
                    page_h = min(_UI_MAX_LINES, int(block_len * 1.25) + 16)
                else:
                    page_h = stitch_h

                if page_h != height:
                    flush_ev.clear()
                    try:
                        nv.request(
                            "nvim_ui_try_resize",
                            width,
                            page_h,
                            timeout=max(0.0, deadline - time.time()),
                        )
                        height = page_h
                        nv.request(
                            "nvim_command",
                            "redraw!",
                            timeout=max(0.0, deadline - time.time()),
                        )
                        flush_ev.wait(
                            timeout=min(1.0, max(0.0, deadline - time.time()))
                        )
                    except (TimeoutError, RuntimeError) as exc:
                        print(f"nvimcat: page resize failed: {exc}", file=sys.stderr)
                    flush_ev.clear()

                flush_ev.clear()
                try:
                    with grid_lock:
                        before = grid.to_ansi()
                    _scroll_page(nv, topline, max(0.0, deadline - time.time()))
                    _wait_grid_change(
                        nv,
                        grid,
                        grid_lock,
                        flush_ev,
                        before,
                        deadline=deadline,
                        max_wait=0.5,
                    )
                except (TimeoutError, RuntimeError) as exc:
                    print(f"nvimcat: scroll failed: {exc}", file=sys.stderr)
                    break
                flush_ev.clear()

                with grid_lock:
                    part = grid.to_ansi()
                if output_parts:
                    part = _trim_page_overlap(output_parts[-1], part)
                if part:
                    if output_parts and not output_parts[-1].endswith(b"\n"):
                        output_parts.append(b"\n")
                    output_parts.append(part)
                pages_done += 1
                awaiting_resize_flush = False

                try:
                    info = _win_page_info(nv, max(0.0, deadline - time.time()))
                except (TimeoutError, RuntimeError):
                    info = {"top": topline, "bot": topline, "last": last_line}

                if info["bot"] >= info["last"]:
                    break

                # Always advance by painted buffer coverage (not block_end alone),
                # otherwise small tables re-capture nearly the same viewport.
                topline = info["bot"] + 1
                if topline <= info["top"]:
                    topline = info["top"] + 1

            try:
                nv.request(
                    "nvim_set_var",
                    "nvimcat_capture",
                    0,
                    timeout=max(0.0, deadline - time.time()),
                )
            except (TimeoutError, RuntimeError):
                pass
            continue
        else:
            print("nvimcat: timed out waiting for capture", file=sys.stderr)
    finally:
        nv.close()
    return rc


def smoke(width: int) -> int:
    nv = NvimEmbed()
    try:
        nv.ui_attach(width, 24)
        nv.request("nvim_command", "qa!")
    finally:
        nv.close()
    return 0


def main() -> int:
    if len(sys.argv) >= 3 and sys.argv[1] == "--smoke":
        return smoke(int(sys.argv[2]))
    if len(sys.argv) < 3:
        print("usage: nvimcat-embed WIDTH <file>...", file=sys.stderr)
        print("       nvimcat-embed --smoke WIDTH", file=sys.stderr)
        return 2
    width = int(sys.argv[1])
    files = sys.argv[2:]
    return capture(width, files)

# --- CLI --------------------------------------------------------------------

def _detect_width() -> int:
    env = os.environ.get("NVIMCAT_WIDTH", "").strip()
    if env.isdigit() and int(env) > 0:
        return int(env)
    try:
        out = subprocess.check_output(
            ["bash", "-c", "stty size < /dev/tty"], stderr=subprocess.DEVNULL
        )
        cols = int(out.split()[1])
        if cols > 0:
            return cols
    except (OSError, subprocess.CalledProcessError, IndexError, ValueError):
        pass
    try:
        out = subprocess.check_output(["tput", "cols"], stderr=subprocess.DEVNULL)
        cols = int(out.strip())
        if cols > 0:
            return cols
    except (OSError, subprocess.CalledProcessError, ValueError):
        pass
    cols = os.environ.get("COLUMNS", "").strip()
    if cols.isdigit() and int(cols) > 0:
        return int(cols)
    return 80


def _abs_files(files: list[str]) -> list[str]:
    out: list[str] = []
    for f in files:
        p = Path(f)
        out.append(str(p.resolve()) if p.exists() else f)
    return out


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    os.environ.setdefault("NVIMCAT", "1")
    os.environ["NVIMCAT_ROOT"] = str(_ROOT)

    if argv and argv[0] == "--shot2ansi":
        return shot2ansi_main(argv[1:])

    if argv and argv[0] == "--smoke":
        width = int(argv[1]) if len(argv) > 1 else _detect_width()
        return smoke(width)

    if argv and argv[0] == "--compose":
        os.environ["NVIMCAT_COMPOSE"] = "1"
        argv = argv[1:]

    # Legacy: WIDTH file... (old nvimcat-embed argv)
    if len(argv) >= 2 and argv[0].isdigit() and not Path(argv[0]).exists():
        width = int(argv[0])
        files = _abs_files(argv[1:])
        os.environ["NVIMCAT_WIDTH"] = str(width)
        return capture(width, files)

    if not argv:
        print("usage: nvimcat [--compose] [--width N] <file>...", file=sys.stderr)
        print("       nvimcat --smoke [WIDTH]", file=sys.stderr)
        print("       nvimcat --shot2ansi [screenshot]", file=sys.stderr)
        return 2

    from shutil import which

    if which("nvim") is None:
        print("nvimcat: nvim not found on PATH", file=sys.stderr)
        return 127

    width = _detect_width()
    files = argv
    if files[:1] == ["--width"]:
        if len(files) < 3:
            print("usage: nvimcat --width N <file>...", file=sys.stderr)
            return 2
        width = int(files[1])
        files = files[2:]
    files = _abs_files(files)
    os.environ["NVIMCAT_WIDTH"] = str(width)
    return capture(width, files)


if __name__ == "__main__":
    raise SystemExit(main())
