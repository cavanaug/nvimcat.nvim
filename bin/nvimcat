#!/usr/bin/env bash
# nvimcat — dump a file as ANSI using your full Neovim config (plugins, themes, …).
# Uses nvim --embed + UI attach so output matches the real TUI cell grid.
set -euo pipefail

# Resolve symlinks so ~/.local/bin/nvimcat → plugin tree, not ~/.local.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" != /* ]]; then
    SOURCE="$(cd "$(dirname "$SOURCE")" && pwd)/$TARGET"
  else
    SOURCE="$TARGET"
  fi
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
export NVIMCAT=1
export NVIMCAT_ROOT="$ROOT"

# Width: explicit NVIMCAT_WIDTH > controlling TTY > tput > COLUMNS > 80.
if [[ -z "${NVIMCAT_WIDTH:-}" ]]; then
  cols=""
  cols="$(bash -c 'stty size < /dev/tty' 2>/dev/null | awk '{print $2}' || true)"
  if [[ ! "${cols}" =~ ^[1-9][0-9]*$ ]]; then
    cols="$(tput cols 2>/dev/null || true)"
  fi
  if [[ ! "${cols}" =~ ^[1-9][0-9]*$ ]]; then
    cols="${COLUMNS:-}"
  fi
  if [[ ! "${cols}" =~ ^[1-9][0-9]*$ ]]; then
    cols=80
  fi
  export NVIMCAT_WIDTH="$cols"
fi

if ! command -v nvim >/dev/null 2>&1; then
  echo "nvimcat: nvim not found on PATH" >&2
  exit 127
fi

if [[ $# -lt 1 ]]; then
  echo "usage: nvimcat <file>..." >&2
  exit 2
fi

files=()
for f in "$@"; do
  if [[ -e "$f" ]]; then
    files+=("$(cd "$(dirname "$f")" && pwd)/$(basename "$f")")
  else
    files+=("$f")
  fi
done

exec python3 "$ROOT/bin/nvimcat-embed" "$NVIMCAT_WIDTH" "${files[@]}"
